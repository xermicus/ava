    ldi r15, 0
    matein1 r0
    jz r0, live
    ldi r0, 1000000
    score r0
    halt
live:
    ldi r0, 0
    ispromo r1
    jz r1, nopromo
    promo r2
    ld r3, r2, values
    addi r0, r0, 3000
    add r0, r0, r3
nopromo:
    movedpiece r4
    addi r5, r4, -1
    jnz r5, notpawn
    torank r6
    mul r7, r6, r6
    muli r7, r7, 30
    add r0, r0, r7
    addi r0, r0, 150
notpawn:
    see r8
    jge r8, r15, seeok
    muli r8, r8, 3
seeok:
    add r0, r0, r8
    score r0
    halt

.data
values: .word 0, 100, 320, 330, 500, 900, 0
