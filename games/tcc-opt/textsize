#!/usr/bin/env python3

# Print the bytes of the executable segments of a 64 bit little endian ELF,
# the code of the program however its sections are named.

import struct
import sys

ELF_MAGIC = b"\x7fELF"
CLASS_64 = 2
LITTLE_ENDIAN = 1
PT_LOAD = 1
PF_X = 1

with open(sys.argv[1], "rb") as file:
    image = file.read()

if image[:4] != ELF_MAGIC or image[4] != CLASS_64 or image[5] != LITTLE_ENDIAN:
    sys.exit(f"{sys.argv[1]} is not a 64 bit little endian ELF")

(offset,) = struct.unpack_from("<Q", image, 0x20)
size, count = struct.unpack_from("<HH", image, 0x36)

executable = 0
for index in range(count):
    kind, flags, _, _, _, filesz = struct.unpack_from("<IIQQQQ", image, offset + index * size)
    if kind == PT_LOAD and flags & PF_X:
        executable += filesz

print(executable)
