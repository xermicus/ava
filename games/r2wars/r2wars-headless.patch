@@ -0,0 +1,76 @@
+using System;
+using System.IO;
+using System.Threading;
+
+namespace r2warsTorneo
+{
+    // A combat on the console, without the web server.
+    public static class Headless
+    {
+        public const string Usage = "usage: r2wars --fight <warrior.asm> <warrior.asm>";
+
+        public static int Fight(string first, string second)
+        {
+            TextWriter console = Console.Out;
+            Console.SetOut(TextWriter.Null);
+
+            foreach (string path in new[] { first, second })
+            {
+                string problem = Check(path);
+                if (problem != null)
+                {
+                    Console.Error.WriteLine(problem);
+                    return 1;
+                }
+            }
+
+            r2wars game = new r2wars();
+            ManualResetEventSlim finished = new ManualResetEventSlim();
+            game.Event_roundEnd += (sender, e) => console.WriteLine(
+                "round " + (e.round + 1) + ": " + e.winnername + " wins after " + e.ciclos + " cycles, " +
+                e.losername + " died: " + e.loserreason + " " + Squeeze(e.loserins));
+            game.Event_roundExhausted += (sender, e) => console.WriteLine(
+                "round " + (e.round + 1) + ": timeout after " + e.ciclos + " cycles");
+            game.Event_combatEnd += (sender, e) =>
+            {
+                console.WriteLine(e.winnername == "Draw" ? "draw" : "winner: " + e.winnername);
+                finished.Set();
+            };
+
+            if (!game.playcombat(first, second, Name(first), Name(second), false, true))
+            {
+                Console.Error.WriteLine("the combat could not be initialized");
+                return 1;
+            }
+            finished.Wait();
+            return 0;
+        }
+
+        static string Check(string path)
+        {
+            if (!File.Exists(path))
+                return path + ": no such file";
+            WarriorAssemblyResult result = WarriorCompiler.Assemble(new BrowserWarriorSource
+            {
+                Name = Path.GetFileName(path),
+                Source = File.ReadAllText(path)
+            });
+            if (!result.Ok)
+                return path + ": " + result.Message;
+            return null;
+        }
+
+        static string Squeeze(string text)
+        {
+            return string.Join(" ", text.Split((char[])null, StringSplitOptions.RemoveEmptyEntries));
+        }
+
+        static string Name(string path)
+        {
+            string filename = Path.GetFileName(path);
+            return filename.EndsWith(".asm", StringComparison.OrdinalIgnoreCase)
+                ? filename.Substring(0, filename.Length - ".asm".Length)
+                : filename;
+        }
+    }
+}
