#!/bin/bash

# Score every push to the task branch and answer the pusher. Each attempt is
# one line appended to the attempts file the run collects as score.log, and a
# release tag leaves the marker ending the run.

set -uo pipefail

HOME_DIR=/home/agent
GAME=$(cat "$HOME_DIR/game")
STARTED=$(cat "$HOME_DIR/started")

while read -r _ new ref; do
	if [ "$ref" = "refs/tags/release" ]; then
		touch "$HOME_DIR/done"
		echo "release received, the run ends"
		continue
	fi

	if [ "$ref" != "refs/heads/task" ]; then
		echo "only the task branch runs the pipeline"
		continue
	fi

	seconds=$(( $(date +%s) - STARTED ))
	scratch=$(mktemp -d)
	mkdir "$scratch/submission"
	git archive "$new" | tar -x -C "$scratch/submission"

	report=$(cd "$scratch" && timeout 90 ava score --game "$GAME" 2>"$scratch/stderr")
	status=$?

	if [ $status -ne 0 ]; then
		echo "the pipeline failed: $(tail -1 "$scratch/stderr")"
		rm -rf "$scratch"
		continue
	fi
	rm -rf "$scratch"

	line=$(printf '%s' "$report" | python3 -c '
import json, sys
score = json.load(sys.stdin)["score"]
attempt = {"seconds": int(sys.argv[1]), "solved": score["solved"], "points": score["points"]}
if score.get("reason"):
    attempt["reason"] = score["reason"]
print(json.dumps(attempt))
' "$seconds")

	echo "$line" >> "$HOME_DIR/attempts.jsonl"
	echo "pipeline: $line"
done
