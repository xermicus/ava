#!/bin/bash

# Verify every push to the task branch and answer the pusher. Each attempt is
# one line appended to the attempts file the run collects as score.log, the
# entry of a passing attempt is kept under entries/<seconds>/, and a release
# tag leaves the marker ending the run.

set -uo pipefail

HOME_DIR=/home/agent
GAME=$(cat "$HOME_DIR/game")
STARTED=$(cat "$HOME_DIR/started")

# The entry this run attacks, mounted by ava when the run plays a pairing.
CHALLENGE=()
if [ -d "$HOME_DIR/challenge" ]; then
	CHALLENGE=(--challenge "$HOME_DIR/challenge")
fi

while read -r _ new ref; do
	if [ "$ref" = "refs/tags/release" ]; then
		touch "$HOME_DIR/done"
		echo "release received, the run ends"
		continue
	fi

	if [ "$ref" != "refs/heads/task" ]; then
		echo "only the task branch runs the pipeline"
		continue
	fi

	seconds=$(( $(date +%s) - STARTED ))
	scratch=$(mktemp -d)
	mkdir "$scratch/submission"
	git archive "$new" | tar -x -C "$scratch/submission"

	report=$(cd "$scratch" && timeout 90 ava score --game "$GAME" "${CHALLENGE[@]}" 2>"$scratch/stderr")
	status=$?

	if [ $status -ne 0 ]; then
		echo "the pipeline failed: $(tail -1 "$scratch/stderr")"
		rm -rf "$scratch"
		continue
	fi

	line=$(printf '%s' "$report" | python3 -c '
import json, os, shutil, sys
seconds, scratch, home = int(sys.argv[1]), sys.argv[2], sys.argv[3]
report = json.load(sys.stdin)
verdict = report["verdict"]
attempt = {"seconds": seconds, "passed": verdict["passed"]}
if verdict.get("reason"):
    attempt["reason"] = verdict["reason"]
if verdict["passed"]:
    kept = os.path.join(home, "entries", str(seconds))
    os.makedirs(kept, exist_ok=True)
    shutil.copy(os.path.join(scratch, "submission", report["entry"]), kept)
line = json.dumps(attempt)
with open(os.path.join(home, "attempts.jsonl"), "a") as attempts:
    attempts.write(line + "\n")
print(line)
' "$seconds" "$scratch" "$HOME_DIR")

	rm -rf "$scratch"
	echo "pipeline: $line"
done
