#!/bin/bash

set -euo pipefail

# The server loads plugins only once it serves a request, and a request
# arriving during the bootstrap hangs. Poll with a timeout until the loop
# plugin has created its session.
if [ "${1:-}" = "serve" ]; then
	until curl -sf --max-time 3 http://127.0.0.1:4096/session 2>/dev/null | grep -q '"id"'; do
		sleep 0.2
	done &
fi

exec opencode "$@"
